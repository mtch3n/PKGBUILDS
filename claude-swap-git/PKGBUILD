# Maintainer: mtch3n

pkgname=claude-swap-git
_pkgname=claude-swap
pkgver=0.26.0b1.r503.g0fc33ff
pkgrel=1
pkgdesc="Multi-account switcher for Claude Code — mtch3n fork, with Linux desktop notifications and a systemd user service"
arch=('any')
url="https://github.com/mtch3n/claude-swap"
license=('MIT')
depends=('python' 'python-textual' 'python-truststore')
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-hatchling')
checkdepends=('python-pytest' 'python-pytest-asyncio' 'python-pytest-xdist')
optdepends=('libnotify: desktop notifications for auto-switch events'
            'systemd: run the auto-switcher in the background (cswap service)')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
	cd "$_pkgname"
	# Built from a branch, not a release: upstream's own version plus the
	# commit it came from. The r-count only grows, so upgrades stay ordered
	# across a version bump.
	local _ver
	_ver="$(sed -n 's/^version = "\(.*\)"$/\1/p' pyproject.toml | head -1)"
	printf "%s.r%s.g%s" "${_ver:-0}" \
		"$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
	cd "$_pkgname"
	python -m build --wheel --no-isolation
}

check() {
	cd "$_pkgname"
	# __version__ comes from importlib.metadata, which finds nothing in a bare
	# source tree, so the wheel's .dist-info has to be on PYTHONPATH or every
	# test errors at import.
	local _site
	_site="$(python -c 'import site; print(site.getsitepackages()[0])')"
	python -m installer --destdir="$srcdir/check-env" dist/*.whl
	PYTHONPATH="$srcdir/check-env$_site" python -m pytest
}

package() {
	cd "$_pkgname"
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
