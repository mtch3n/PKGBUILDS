# Maintainer: mtch3n
# A systemd timer that keeps system Flatpaks up to date.
#
# Ships only its OWN package-tracked unit files under /usr/lib/systemd/system
# (it never edits a foreign config file). The install scriptlet only enables
# the timer — an additive, reversible action.
#
# Install: sudo pacman -S flatpak-autoupdate
pkgname=flatpak-autoupdate
pkgver=1.0.0
pkgrel=3
pkgdesc="Systemd timer that auto-updates system Flatpaks daily"
arch=('any')
license=('MIT')
depends=('flatpak' 'systemd')
install="${pkgname}.install"
source=('flatpak-update.service'
        'flatpak-update.timer'
        'README.md')
sha256sums=('e00bb434ae0f8f74e5f4cb7fc400e4b71c5c8159ebda1816b8ab2fd794edde8e'
            'cbbfb5d5de754813c1ef53b907fd865bfb2b7ae5984a756a9be5ce8e8e5709ce'
            '502fab5d4554f74ff56911e15cdc362974253a0bd874745e5e2d93b4dd5db527')

package() {
  install -Dm644 "${srcdir}/flatpak-update.service" \
    "${pkgdir}/usr/lib/systemd/system/flatpak-update.service"
  install -Dm644 "${srcdir}/flatpak-update.timer" \
    "${pkgdir}/usr/lib/systemd/system/flatpak-update.timer"
  install -Dm644 "${srcdir}/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
