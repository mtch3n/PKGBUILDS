# No initramfs regeneration here on purpose: mkinitcpio's own pacman hook
# already triggers on usr/lib/initcpio/*, PostTransaction, and running
# mkinitcpio by hand from a scriptlet fires too early and bypasses the
# limine hooks.

post_install() {
  cat <<'MSG'
==> Reboot to apply the ACPI override. Then verify:
      journalctl -k -b | grep -iE 'CNVW|WIST|AE_NOT_FOUND'   # expect no output
      dmesg | grep -iE 'ACPI.*overriding|SSDT.*XPSWIFI'      # override loaded
      nmcli -f SSID,FREQ dev wifi list                       # 6 GHz APs, if any
MSG
}

post_upgrade() {
  echo "==> Reboot to apply."
}

post_remove() {
  echo "==> Reboot to fully drop the ACPI override."
}
