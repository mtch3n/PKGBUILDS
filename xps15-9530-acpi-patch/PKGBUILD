# Maintainer: mtch3n
# XPS 15 9530 (Intel AX211 CNVi) ACPI override, compiled at build time and
# loaded via mkinitcpio's acpi_override hook. Reboot to apply.
#
# The 6E/UHBS half follows al3xtjames' SSDT-WiFi-6E.asl:
#   https://gist.github.com/al3xtjames/9fb54405093aaf2aff39c58f0eb3a96a
# The CNVW/_DSM abort fix in xps15-wifi.asl is additional.
pkgname=xps15-9530-acpi-patch
pkgver=1.0.0
pkgrel=3
pkgdesc="XPS15 9530 ACPI override: fix CNVW _DSM (RP28.PXSX.WIST) abort + unlock Wi-Fi 6E (6 GHz). Reboot to apply."
arch=('any')
license=('MIT')
makedepends=('acpica')          # iasl, build-time only
depends=('mkinitcpio')          # provides the acpi_override hook + regen
# conf.d drop-in is user-editable -> emit .pacnew instead of clobbering
backup=('etc/mkinitcpio.conf.d/20-xps15-acpi-override.conf')
install="${pkgname}.install"
source=('xps15-wifi.asl'
        '20-xps15-acpi-override.conf')
sha256sums=('aa449a7959251e726e4ab1d7e1a369799474bcce3bc0f437126f52b73be8ebb2'
            '4b2e8c3e3f9e4f83422adee3661b48ee6fd7f4c6b90fe30daed4313e10eb91ef')

build() {
  iasl -p "${srcdir}/xps15-wifi" "${srcdir}/xps15-wifi.asl"
}

package() {
  install -Dm644 "${srcdir}/xps15-wifi.aml" \
    "${pkgdir}/usr/lib/initcpio/acpi_override/xps15-wifi.aml"

  # Enables the acpi_override hook without editing the user's mkinitcpio.conf.
  install -Dm644 "${srcdir}/20-xps15-acpi-override.conf" \
    "${pkgdir}/etc/mkinitcpio.conf.d/20-xps15-acpi-override.conf"

  # Provenance: ship the ASL the .aml was compiled from.
  install -Dm644 "${srcdir}/xps15-wifi.asl" \
    "${pkgdir}/usr/share/doc/${pkgname}/xps15-wifi.asl"
}
